{
  "permissions": {
    "allow": [
      "Edit(progress/**)",
      "Write(progress/**)",
      "Edit(lessons/**)",
      "Write(lessons/**)",
      "Edit(designs/**)",
      "Write(designs/**)",
      "Edit(mocks/**)",
      "Write(mocks/**)",
      "Edit(reviews/**)",
      "Write(reviews/**)",
      "Edit(README.md)",
      "Bash(date:*)",
      "Bash(tools/run.sh:*)",
      "Bash(tools/stress.sh:*)",
      "Bash(TSAN=1 tools/run.sh:*)",
      "Bash(NOCHECK=1 tools/run.sh:*)",
      "Bash(python3 tools/gen_tracker.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
